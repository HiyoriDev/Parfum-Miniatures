# Copier ce fichier en .env.local et le compléter (ne jamais committer .env.local).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète (« Secret key » sb_secret_…, ou l'ancienne « service_role »).
# Utilisée uniquement côté serveur pour les écritures de l'admin.
SUPABASE_SECRET_KEY=

# Session admin : longue chaîne aléatoire (ex. `openssl rand -base64 48`)
JWT_SECRET=

# Connexion Google (Google Cloud > Google Auth Platform > Clients)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Adresses Google autorisées, séparées par des virgules (elles ouvrent toutes le même compte admin)
ADMIN_GOOGLE_EMAILS=
